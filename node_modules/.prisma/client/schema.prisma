// Prisma schema — backend-api
// 7 entidades de functional-design/entities.md: User, Session, Vendor,
// CommissionTier, DailySale, CommissionPeriod, Notification.
// Fuente: aidlc/.../functional-design/entities.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  vendedor
  supervisor
}

enum Channel {
  preventa
  autoventa
}

enum TierType {
  por_devolucion
  por_efectividad
}

enum SyncStatus {
  synced
  pending
}

enum NotificationType {
  umbral_venta
  umbral_devolucion
  manual
}

/// Identidad y credenciales de quien se autentica (vendedor o supervisor).
model User {
  id           String   @id @default(cuid())
  role         Role
  /// requerido solo cuando role=vendedor; único entre todos los User con role=vendedor
  username     String?  @unique
  /// requerido solo cuando role=vendedor; solo interno, nunca se expone en response
  passwordHash String?
  /// requerido solo cuando role=supervisor; solo interno, nunca se expone en response
  pin          String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  vendor   Vendor?

  @@map("users")
}

/// Sesión activa emitida al autenticar. Ninguna Session expira por tiempo
/// transcurrido (BR1.4, BR1.5) — solo termina por logout explícito o revocación manual.
model Session {
  id        String    @id @default(cuid())
  /// token opaco — lookup por token en cada petición protegida
  token     String    @unique @default(cuid())
  userId    String
  createdAt DateTime  @default(now())
  /// siempre ausente/nulo en este MVP — ningún rol tiene sesión con expiración por tiempo
  expiresAt DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("sessions")
}

/// Vendedor del roster, con su ruta, canal y presupuesto vigente.
model Vendor {
  id        String   @id @default(cuid())
  userId    String   @unique
  route     String
  name      String
  channel   Channel
  budget    Decimal  @db.Decimal(14, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id])
  dailySales        DailySale[]
  commissionPeriods CommissionPeriod[]
  notifications     Notification[]

  @@index([channel])
  @@index([route])
  @@map("vendors")
}

/// Tramo de comisión configurado por canal, con su orden relativo.
model CommissionTier {
  id             String   @id @default(cuid())
  channel        Channel
  tierType       TierType
  order          Int
  /// porcentaje: umbral de indicador de devolución o de efectividad de venta sobre presupuesto
  thresholdValue Decimal  @db.Decimal(7, 3)
  /// porcentaje aplicado sobre la venta acumulada del período (BR4.3)
  commissionRate Decimal  @db.Decimal(7, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([channel, order])
  @@map("commission_tiers")
}

/// Venta y devoluciones de un vendedor en un día, con soporte para registro sin conexión.
model DailySale {
  id         String     @id @default(cuid())
  vendorId   String
  saleDate   DateTime   @db.Date
  amount     Decimal    @db.Decimal(14, 2)
  returns    Decimal    @db.Decimal(14, 2)
  syncStatus SyncStatus @default(synced)
  closed     Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])

  /// único por (vendorId, saleDate) — clave de idempotencia de sincronización (NFR4.2, ADR-004)
  @@unique([vendorId, saleDate])
  @@map("daily_sales")
}

/// Agregado mensual de comisión, venta e indicador de devolución de un vendedor.
model CommissionPeriod {
  id                 String    @id @default(cuid())
  vendorId           String
  /// formato AAAA-MM
  periodMonth        String
  accumulatedSales   Decimal   @default(0) @db.Decimal(14, 2)
  accumulatedReturns Decimal   @default(0) @db.Decimal(14, 2)
  /// accumulatedReturns / accumulatedSales; 0 cuando accumulatedSales es 0 (BR8.1)
  returnRate         Decimal   @default(0) @db.Decimal(9, 6)
  commissionEarned   Decimal   @default(0) @db.Decimal(14, 2)
  closed             Boolean   @default(false)
  closedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, periodMonth])
  @@index([closed, vendorId])
  @@map("commission_periods")
}

/// Notificación entregada a un vendedor — de umbral automático o manual del supervisor.
/// También funciona como el registro de seguimiento de qué umbrales ya se notificaron
/// en el período vigente (Q6 de functional-design-questions.md) — de ahí el campo
/// interno periodMonth, no expuesto en el contrato, usado solo para la consulta de
/// no-duplicación de BR7.2/BR8.2.
model Notification {
  id                 String           @id @default(cuid())
  vendorId           String
  type               NotificationType
  /// presente solo cuando type≠manual
  thresholdCrossed   Decimal?         @db.Decimal(7, 3)
  /// presente solo cuando type=umbral_devolucion y los tramos del canal están en orden (BR8.3)
  earningOpportunity Json?
  message            String
  sentAt             DateTime         @default(now())
  read               Boolean          @default(false)
  /// campo interno de persistencia (no en el contrato) — período vigente al momento del envío,
  /// usado como parte de la clave de no-duplicación (vendorId, type, thresholdCrossed, periodMonth)
  periodMonth        String

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@index([vendorId, type, periodMonth])
  @@map("notifications")
}
