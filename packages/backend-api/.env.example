# Copiar a .env y completar con valores reales — NUNCA commitear secretos
# (cadena de conexión de Neon, etc.) — project.md § Forbidden.

# Cadena de conexión PostgreSQL (Neon) — requerida, el proceso falla al
# arrancar si falta (NFR3.12, fail-fast).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# development | production | test
NODE_ENV=development

# Puerto HTTP del proceso NestJS
PORT=3000
