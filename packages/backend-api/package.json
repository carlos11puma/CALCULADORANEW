{
  "name": "@calculadora-comisiones/backend-api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend NestJS + Prisma + PostgreSQL (Neon) de Calculadora de Comisiones — implementa los 6 componentes de dominio (Auth, VendorDirectory, CommissionTier, SalesEntry, CommissionLedger, Notification) contra el contrato de @calculadora-comisiones/api-contract.",
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@calculadora-comisiones/api-contract": "*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "^1.16.2",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^2.1.8",
    "vitest-mock-extended": "^2.0.2"
  }
}
