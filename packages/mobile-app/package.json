    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "axios-mock-adapter": "^2.1.0",
    "@types/react": "~18.2.79",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.4",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.7.2"
  }
