{
  "name": "@calculadora-comisiones/mobile-app",
  "version": "1.0.0",
  "private": true,
  "description": "App móvil (Expo + React Native + TypeScript) de Calculadora de Comisiones — consume los 6 contratos de @calculadora-comisiones/api-contract; app del vendedor (V1-V6) y panel del administrador (A1-A5).",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint src --ext .ts,.tsx",
