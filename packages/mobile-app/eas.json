{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "API_BASE_URL": "https://api-dev.calculadora-comisiones.internal"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "API_BASE_URL": "https://backend-api-staging-0q01.onrender.com"
      }
    },
    "production": {
      "distribution": "internal",
      "channel": "production",
      "env": {
        "API_BASE_URL": "https://backend-api-production-dffp.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
